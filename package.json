{
  "name": "geek-toolbox",
  "productName": "极客工具箱",
  "version": "0.0.11",
  "description": "极客工具箱 - Windows 本地开发者工具箱",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "vite build --config cli/vite.config.js",
    "test:cli": "node --test tests/cli/smoke.test.mjs",
    "release": "node scripts/release.mjs",
    "release:desktop": "node scripts/release.mjs",
    "electron:dev": "vite build && electron .",
    "check:packaging": "node scripts/check-packaging-assets.mjs",
    "build:win": "npm run check:packaging && vite build && electron-builder --win --x64 --dir --publish never",
    "package:win": "npm run check:packaging && vite build && electron-builder --win nsis --x64 --publish never",
    "test": "vitest run",
    "test:desktop": "vite build && electron tests/electron/batch-smoke.cjs",
    "test:updater": "node scripts/verify-updater-runtime.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node scripts/clean.mjs"
  },
  "build": {
    "appId": "cn.toolhelper.toolbox",
    "productName": "极客工具箱",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "极客工具箱",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "GeekToolbox-Setup-${version}.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "differentialPackage": false
    }
  },
  "keywords": [],
  "author": "GeekToolBox",
  "license": "MIT",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.4"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "lucide-vue-next": "^0.577.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "qrcode": "^1.5.4"
  }
}

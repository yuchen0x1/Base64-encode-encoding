{
  "name": "geek-toolbox",
  "productName": "极客工具箱",
  "version": "0.0.1",
  "description": "极客工具箱 - 跨端响应式现代化工具箱",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/serve.js",
    "serve:build": "vite build && node server/serve.js",
    "release": "node scripts/release.mjs",
    "release:desktop": "node scripts/release.mjs --desktop",
    "electron:dev": "vite build && electron .",
    "build:win": "vite build && electron-builder --win --x64 --dir --publish never",
    "package:win": "vite build && electron-builder --win nsis --x64 --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node scripts/clean.mjs"
  },
  "build": {
    "appId": "cn.toolhelper.toolbox",
    "productName": "极客工具箱",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "极客工具箱",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "GeekToolbox-Setup-${version}.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "keywords": [],
  "author": "GeekToolBox",
  "license": "MIT",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.4"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "lucide-vue-next": "^0.577.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "qrcode": "^1.5.4"
  }
}

{
  "name": "geek-toolbox",
  "productName": "极客工具箱",
  "version": "1.1.0",
  "description": "极客工具箱 - 跨端响应式现代化工具箱",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "build:win": "vite build && electron-builder --win --x64 --dir",
    "package:win": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "cn.toolhelper.toolbox",
    "productName": "极客工具箱",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "keywords": [],
  "author": "GeekToolBox",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-vue-next": "^0.577.0",
    "vite": "^8.3.6",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "qrcode": "^1.5.4"
  }
}
